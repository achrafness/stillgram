{
  "expo": {
    "name": "Stillgram",
    "slug": "Stillgram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/stillgram-icon.png",
    "scheme": "stillgram",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/stillgram-adaptive.png",
        "backgroundImage": "./assets/images/stillgram-adaptive-bg.png",
        "backgroundColor": "#C13584"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Stillgram"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0f",
          "image": "./assets/images/stillgram-splash.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}